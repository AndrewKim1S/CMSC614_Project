Bootstrap: docker
From: ubuntu:24.04

# Shared runtime for every tool in the project (AFL++, WhiteFox, black-box LLM,
# Our System). Nexus nodes run RHEL 9 with glibc 2.34, but the dataset binaries
# need glibc >= 2.38, so everything runs inside this image (glibc 2.39).

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates file binutils python3 python3-venv \
        gdb strace ltrace linux-tools-common linux-tools-generic \
        libssl3t64 libpcap0.8t64 libreadline8t64 libpng16-16t64 zlib1g \
        libtinfo6 libstdc++6 libgcc-s1 libelf1t64 libdw1t64 libfaad2 \
        afl++
    rm -rf /var/lib/apt/lists/*
    # /usr/bin/perf refuses to run on a kernel it was not packaged for (the
    # host runs a RHEL kernel); call the packaged binary directly instead.
    ln -sf "$(ls -d /usr/lib/linux-tools/*/perf | head -1)" /usr/local/bin/perf

%environment
    export LC_ALL=C.UTF-8
    # Nexus pipes core dumps to systemd-coredump and we cannot change that.
    export AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1

%test
    ldd --version | head -1
    gdb --version | head -1
    strace -V | head -1
    ltrace -V | head -1
    perf --version
    afl-fuzz -h 2>&1 | head -1 || true
    command -v afl-qemu-trace || echo "afl-qemu-trace: not included"

%labels
    Project CMSC614 LLM-guided black-box fuzzing
