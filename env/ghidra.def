Bootstrap: docker
From: ubuntu:24.04

# Ghidra headless for Our System's static reconstruction. Analysis runs once per
# target ahead of a campaign (harness/run_ghidra.sh) and is cached as JSON lines,
# so the fuzzing image (fuzz.def) stays small.

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # Ghidra 12.2 needs JDK 25 (application.java.min=25); binutils for strip,
    # so the analyzed binary is byte-identical to the one the fuzzer uses.
    apt-get install -y --no-install-recommends \
        ca-certificates curl unzip binutils python3 openjdk-25-jdk-headless
    rm -rf /var/lib/apt/lists/*
    ZIP=ghidra_12.2_PUBLIC_20261016.zip
    curl -fsSL -o /tmp/$ZIP \
        https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.2_build/$ZIP
    unzip -q /tmp/$ZIP -d /opt
    rm /tmp/$ZIP
    ln -s /opt/ghidra_12.2_PUBLIC /opt/ghidra

%environment
    export GHIDRA_HOME=/opt/ghidra
    export LC_ALL=C.UTF-8
    # analyzeHeadless defaults to a 2G heap; this variable overrides it.
    export GHIDRA_HEADLESS_MAXMEM=${GHIDRA_HEADLESS_MAXMEM:-12G}

%test
    java -version 2>&1 | head -1
    grep '^application.version' /opt/ghidra/Ghidra/application.properties

%labels
    Project CMSC614 Ghidra headless for static reconstruction
